# OpenAI API key for AI-assisted XML recovery and prediction forecasting (optional)
OPENAI_API_KEY=your-api-key-here

# Model to use for XML extraction and predictions (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Persistent database location (default: ./data/captain_scheduler.db)
# DATA_DIR=/path/to/persistent/storage
# DATABASE_URL=sqlite:////absolute/path/to/captain_scheduler.db
